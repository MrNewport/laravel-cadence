{
    "name": "mrnewport/laravel-cadence",
    "description": "Anchored calendar recurrence and elapsed-time delivery cutoffs for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0 || ^13.0",
        "nesbot/carbon": "^3.0",
        "illuminate/console": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "MrNewport\\LaravelCadence\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MrNewport\\LaravelCadence\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MrNewport\\LaravelCadence\\CadenceServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
